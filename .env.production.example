COMPOSE_PROJECT_NAME=innovation_portal

INNOVATION_PORTAL_SERVER_HOST=10.6.1.241
INNOVATION_PORTAL_PUBLIC_PORT=18180
INNOVATION_PORTAL_STAFF_PORT=18181
INNOVATION_PORTAL_BACKEND_PORT=18182

INNOVATION_PORTAL_SECRET_KEY=replace-with-a-long-random-secret
INNOVATION_PORTAL_POSTGRES_DB=innovation_portal
INNOVATION_PORTAL_POSTGRES_USER=innovation_portal
INNOVATION_PORTAL_POSTGRES_PASSWORD=replace-with-a-long-random-password

INNOVATION_PORTAL_ADMIN_EMAIL=admin@innovation-portal.local
INNOVATION_PORTAL_ADMIN_PASSWORD=replace-with-a-strong-password
INNOVATION_PORTAL_ADMIN_FIRST_NAME=Portal
INNOVATION_PORTAL_ADMIN_LAST_NAME=Admin

INNOVATION_PORTAL_ALLOWED_HOSTS=10.6.1.241,localhost,127.0.0.1,innovation_portal_backend,innovation_portal_edge
INNOVATION_PORTAL_CORS_ALLOWED_ORIGINS=http://10.6.1.241:18180,http://10.6.1.241:18181
INNOVATION_PORTAL_CSRF_TRUSTED_ORIGINS=http://10.6.1.241:18180,http://10.6.1.241:18181,http://10.6.1.241:18182

# Set these to True once TLS is terminated in front of the stack.
INNOVATION_PORTAL_SESSION_COOKIE_SECURE=False
INNOVATION_PORTAL_CSRF_COOKIE_SECURE=False
INNOVATION_PORTAL_SECURE_PROXY_SSL_HEADER=False

INNOVATION_PORTAL_DEFAULT_FROM_EMAIL=noreply@innovation-portal.local
INNOVATION_PORTAL_CELERY_TASK_ALWAYS_EAGER=False

# Links in emails. Set to the public addresses users actually use,
# e.g. https://innovation.ceda.co.bw and https://innovation.ceda.co.bw/staff
INNOVATION_PORTAL_PUBLIC_BASE_URL=http://10.6.1.241:18180
INNOVATION_PORTAL_STAFF_BASE_URL=http://10.6.1.241:18181/staff


# --- CEDA staff single sign-on (OIDC, e.g. Microsoft Entra ID) ---------------------------
# Leave CLIENT_ID empty to keep staff SSO switched off. Use a tenant-specific discovery URL,
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
CEDA_SSO_CLIENT_ID=
CEDA_SSO_CLIENT_SECRET=
CEDA_SSO_REDIRECT_URI=https://innovation.ceda.co.bw/staff/auth/ceda_staff/callback
CEDA_SSO_DISCOVERY_URL=
# Optional: expected token issuer. Defaults to the issuer in the discovery document.
CEDA_SSO_ISSUER=
CEDA_SSO_SCOPES=openid email profile
# Allow lists (comma separated). A person gets staff access only if their email domain OR
# one of their groups matches. With both empty, every staff SSO sign-in is refused.
CEDA_SSO_ALLOWED_DOMAINS=ceda.co.bw
# Group object IDs (Entra) or names, as they appear in the token's groups claim.
CEDA_SSO_ALLOWED_GROUPS=
CEDA_SSO_GROUPS_CLAIM=groups
# Role given to a staff SSO user who has no staff role yet. staff_member can work on
# assigned tasks only; administrators raise access in the staff console.
CEDA_SSO_DEFAULT_ROLE=staff_member

# --- Text messages ----------------------------------------------------------------------
# Dotted path to a sender class per channel. Empty = no provider: messages are logged and
# marked "skipped". apps.communications.senders.ConsoleMessageSender writes to the log.
INNOVATION_PORTAL_SMS_SENDER=
INNOVATION_PORTAL_WHATSAPP_SENDER=
INNOVATION_PORTAL_USSD_SENDER=
# Channel for sign-in codes sent to a phone: sms or whatsapp.
INNOVATION_PORTAL_LOGIN_CODE_PHONE_CHANNEL=sms
